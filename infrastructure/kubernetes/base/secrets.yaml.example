apiVersion: v1
kind: Secret
metadata:
  name: sovra-secrets
  labels:
    app: sovra
type: Opaque
stringData:
  # Copy this file to secrets.yaml and replace values before deploying.
  # Do NOT commit secrets.yaml to version control.
  # Prefer: kubectl create secret, sealed-secrets, or external-secrets-operator.
  database.username: "sovra"
  database.password: "REPLACE_ME"
  vault.token: "REPLACE_ME"
